# LeadFlow Frontend Environment Configuration

# API Mode - determines which data provider to use
# Options: "mock" | "real"
# Default: "mock" (if not set)
# - "mock": Uses local in-memory data with simulated API latency
# - "real": Connects to backend API specified in NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MODE=mock

# API URL - backend API base URL (only used when API_MODE=real)
# Example: http://localhost:3001/api
# Example: https://api.leadflow.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000
